{
  "name": "openvpn-connect",
  "productName": "OpenVPN Connect",
  "version": "1.1.0",
  "description": "Cliente gráfico para perfis .ovpn, no visual Liquid Glass do Dual Messenger.",
  "main": "src/main.js",
  "author": "mpjsilva",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "dist": "electron-builder --linux AppImage deb rpm --publish never",
    "dist:rpm": "scripts/rpm/gerar-rpm.sh"
  },
  "build": {
    "appId": "local.openvpnconnect.app",
    "artifactName": "OpenVPNConnect-${version}.${ext}",
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Network;Utility",
      "icon": "assets/icone.png",
      "desktop": {
        "entry": {
          "StartupWMClass": "local.openvpnconnect.app"
        }
      },
      "maintainer": "mpjsilva <56980262+mpjsilva@users.noreply.github.com>"
    },
    "deb": {
      "depends": [
        "openvpn",
        "policykit-1 | polkitd"
      ]
    },
    "rpm": {
      "fpm": [
        "--depends",
        "openvpn",
        "--depends",
        "polkit"
      ]
    },
    "files": [
      "src/**/*",
      "ui/**/*",
      "assets/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "mpjsilva",
        "repo": "openvpn-connect"
      }
    ]
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "26.18.1"
  },
  "homepage": "https://github.com/mpjsilva/openvpn-connect",
  "desktopName": "openvpn-connect.desktop",
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mpjsilva/openvpn-connect.git"
  }
}