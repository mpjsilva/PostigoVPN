{
  "name": "postigovpn",
  "productName": "PostigoVPN",
  "version": "1.2.1",
  "description": "PostigoVPN: interface gráfica para o OpenVPN (CLI).",
  "main": "src/main.js",
  "author": "mpjsilva",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "dist": "electron-builder --linux AppImage deb --publish never && npm run dist:rpm && node scripts/latest-yml.js",
    "dist:rpm": "scripts/rpm/gerar-rpm.sh"
  },
  "build": {
    "appId": "local.postigovpn.app",
    "artifactName": "PostigoVPN-${version}.${ext}",
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Network;Utility",
      "icon": "build/icones",
      "desktop": {
        "entry": {
          "StartupWMClass": "PostigoVPN"
        }
      },
      "maintainer": "mpjsilva <56980262+mpjsilva@users.noreply.github.com>",
      "executableName": "postigovpn",
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0 | libatspi2.0-0t64",
        "libuuid1",
        "libsecret-1-0",
        "openvpn",
        "policykit-1 | polkitd"
      ],
      "fpm": [
        "--replaces",
        "openvpn-connect",
        "--conflicts",
        "openvpn-connect"
      ]
    },
    "rpm": {
      "fpm": [
        "--depends",
        "openvpn",
        "--depends",
        "polkit",
        "--replaces",
        "openvpn-connect"
      ]
    },
    "files": [
      "src/**/*",
      "ui/**/*",
      "assets/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "mpjsilva",
        "repo": "PostigoVPN"
      }
    ]
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "26.18.1",
    "js-yaml": "^4.3.2"
  },
  "homepage": "https://github.com/mpjsilva/PostigoVPN",
  "desktopName": "postigovpn.desktop",
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mpjsilva/PostigoVPN.git"
  }
}
